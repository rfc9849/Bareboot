    <!-- Onboarding screen -->
    <string name="onboarding_welcome_title">Linux on your phone, natively</string>
    <string name="onboarding_welcome_body">Bareboot runs Linux distributions for ARM64 directly on your phone\'s kernel, without emulation. A root service, installed as a KernelSU or Magisk module, mounts the distribution and starts its programs.</string>
    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_req_root">KernelSU or Magisk with the Bareboot module</string>
    <string name="onboarding_req_internet">Internet access to download a distribution</string>
    <string name="onboarding_service_checking">Looking for the Bareboot service</string>
    <string name="onboarding_service_install_title">Install the Bareboot module</string>
    <string name="onboarding_service_install_body">The Bareboot service runs as root outside this app. It starts at boot from a KernelSU or Magisk module.</string>
    <string name="onboarding_step_install_module">In %1$s, open Modules and install bareboot-module.zip.</string>
    <string name="onboarding_step_reboot_ksu">Reboot your phone if %1$s asks you to.</string>
    <string name="onboarding_step_reboot">Reboot your phone.</string>
    <string name="onboarding_step_return">Come back to Bareboot. This page updates by itself.</string>
    <string name="onboarding_service_unauth_title">Allow Bareboot to connect</string>
    <string name="onboarding_service_unauth_body">The service only accepts apps you approve. In %1$s, open Modules and tap Action on Bareboot. This page updates by itself. Reinstalling Bareboot gives it a new app ID, so tap Action again after a reinstall.</string>
    <string name="onboarding_service_failed_title">Could not reach the service</string>
    <string name="onboarding_service_ready_title">Service connected</string>
    <string name="onboarding_service_ready_body">Bareboot can talk to the root service.</string>
    <string name="onboarding_check_body">Bareboot checks the processor and the kernel features it needs.</string>
    <string name="onboarding_folder_title">Share files with Android</string>
    <string name="onboarding_folder_body">Choose a folder in internal storage. Linux sees it at /mnt/android, and the Files app shows it under Bareboot.</string>
