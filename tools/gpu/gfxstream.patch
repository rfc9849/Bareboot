+// Returns a dma-buf for the memory of a gralloc buffer: the first descriptor of its native
+// handle. AHardwareBuffer_getNativeHandle() is not in the NDK, so the handle goes through a
+// socket pair, as for the presentation bridge.
+static int dupAhbDmaBuf(AHardwareBuffer* ahb) {
+    int pair[2];
+    if (socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, pair) != 0) {
+        return -1;
+    }
+    int result = -1;
+    if (AHardwareBuffer_sendHandleToUnixSocket(ahb, pair[0]) == 0) {
+        char data[4096];
+        alignas(struct cmsghdr) char control[CMSG_SPACE(sizeof(int) * 64)];
+        struct iovec iov = {data, sizeof(data)};
+        struct msghdr msg = {};
+        msg.msg_iov = &iov;
+        msg.msg_iovlen = 1;
+        msg.msg_control = control;
+        msg.msg_controllen = sizeof(control);
+        if (recvmsg(pair[1], &msg, MSG_CMSG_CLOEXEC) > 0 && !(msg.msg_flags & MSG_CTRUNC)) {
+            for (struct cmsghdr* c = CMSG_FIRSTHDR(&msg); c; c = CMSG_NXTHDR(&msg, c)) {
+                if (c->cmsg_level != SOL_SOCKET || c->cmsg_type != SCM_RIGHTS) continue;
+                const size_t count = (c->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+                for (size_t i = 0; i < count; ++i) {
+                    int fd;
+                    memcpy(&fd, CMSG_DATA(c) + i * sizeof(int), sizeof(int));
+                    if (result < 0) {
+                        result = fd;
+                    } else {
+                        ::close(fd);
+                    }
+                }
+            }
+        }
+    }
+    ::close(pair[0]);
+    ::close(pair[1]);
+    return result;
+}
+
+static std::optional<gfxstream::base::SharedMemory> exportAhbAsSharedMemory(
+    VulkanDispatch* vk, VkDevice device, VkDeviceMemory memory, VkDeviceSize size) {
+    if (!vk->vkGetMemoryAndroidHardwareBufferANDROID) {
+        GFXSTREAM_ERROR("vkGetMemoryAndroidHardwareBufferANDROID is missing.");
+        return std::nullopt;
+    }
+    const VkMemoryGetAndroidHardwareBufferInfoANDROID getAhbInfo = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_GET_ANDROID_HARDWARE_BUFFER_INFO_ANDROID,
+        .pNext = nullptr,
+        .memory = memory,
+    };
+    AHardwareBuffer* ahb = nullptr;
+    VkResult res = vk->vkGetMemoryAndroidHardwareBufferANDROID(device, &getAhbInfo, &ahb);
+    if (res != VK_SUCCESS || !ahb) {
+        GFXSTREAM_ERROR("vkGetMemoryAndroidHardwareBufferANDROID failed: %s",
+                        string_VkResult(res));
+        return std::nullopt;
+    }
+    const int fd = dupAhbDmaBuf(ahb);
+    AHardwareBuffer_release(ahb);
+    if (fd < 0) {
+        GFXSTREAM_ERROR("Cannot get the dma-buf of an exported AHardwareBuffer.");
+        return std::nullopt;
+    }
+    const off_t bytes = lseek(fd, 0, SEEK_END);
+    if (bytes < 0 || static_cast<VkDeviceSize>(bytes) < size) {
+        GFXSTREAM_ERROR("Exported AHardwareBuffer has %lld bytes, %llu needed.",
