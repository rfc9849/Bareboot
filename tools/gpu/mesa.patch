+static bool syncDmaBufRanges(uint32_t count, const VkMappedMemoryRange* ranges, bool forDevice) {
+#ifdef LINUX_GUEST_BUILD
+    for (uint32_t i = 0; i < count; ++i) {
+        VK_FROM_HANDLE(gfxstream_vk_device_memory, info, ranges[i].memory);
+        if (!info) return false;
+        VirtGpuResourcePtr blob = info->blobPtr;
+        if (!blob && info->coherentMemory) blob = info->coherentMemory->getBlob();
+        if (!blob) return false;
+        VirtGpuExternalHandle handle{};
+        if (blob->exportBlob(handle) != 0 || handle.osHandle < 0) return false;
+        struct dma_buf_sync sync = {};
+        sync.flags = DMA_BUF_SYNC_RW | DMA_BUF_SYNC_START;
+        bool ok = ioctl(handle.osHandle, DMA_BUF_IOCTL_SYNC, &sync) == 0;
+        if (ok && forDevice) {
+            sync.flags = DMA_BUF_SYNC_RW | DMA_BUF_SYNC_END;
+            ok = ioctl(handle.osHandle, DMA_BUF_IOCTL_SYNC, &sync) == 0;
+        }
+        close(handle.osHandle);
+        if (!ok) return false;
+    }
+    return true;
+#else
+    (void)count;
+    (void)ranges;
+    (void)forDevice;
+    return false;
+#endif
+}
