+VkResult ResourceTracker::getBarebootBufferToken(VkDeviceMemory memory, int* fd) {
+#ifdef LINUX_GUEST_BUILD
+    VK_FROM_HANDLE(gfxstream_vk_device_memory, info, memory);
+    if (!info || !info->blobPtr) return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+    VirtGpuExternalHandle handle{};
+    if (info->blobPtr->exportBlob(handle) != 0 || handle.osHandle < 0)
+        return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+    if (static_cast<uint32_t>(handle.type) != 0x04000000) {
+        close(handle.osHandle);
+        return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+    }
+    *fd = handle.osHandle;
+    return VK_SUCCESS;
+#else
+    return VK_ERROR_FEATURE_NOT_PRESENT;
+#endif
+}
