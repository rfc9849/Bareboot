allow bareboot_gpu_renderer bareboot_daemon unix_stream_socket { read write getattr }
allow bareboot_display bareboot_gpu_renderer fd use
allow bareboot_display hal_graphics_allocator_server fd use
allow bareboot_display bareboot_gpu_mem file { getattr read write }

