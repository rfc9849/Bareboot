allow bareboot_gpu_renderer vendor_file file { getattr open read map execute }
allow bareboot_gpu_renderer same_process_hal_file dir { getattr open read search }
allow bareboot_gpu_renderer same_process_hal_file file { getattr open read map execute }
allow bareboot_gpu_renderer same_process_hal_file lnk_file { getattr read }
allow bareboot_gpu_renderer rootfs dir search
allow bareboot_gpu_renderer rootfs lnk_file read
