type bareboot_gpu_renderer domain
enforce bareboot_gpu_renderer
type bareboot_gpu_exec file_type
typeattribute bareboot_gpu_exec exec_type
type bareboot_gpu_guest file_type
type bareboot_gpu_socket file_type
type bareboot_gpu_mem file_type

allow bareboot_gpu_socket tmpfs filesystem associate
allow bareboot_gpu_mem tmpfs filesystem associate
allow bareboot_gpu_exec labeledfs filesystem associate
allow bareboot_gpu_guest labeledfs filesystem associate

allow bareboot_daemon bareboot_gpu_renderer process { transition signal sigkill signull rlimitinh siginh }
allow bareboot_daemon bareboot_gpu_renderer process2 nosuid_transition
allow bareboot_gpu_renderer bareboot_daemon process sigchld
allow bareboot_daemon bareboot_gpu_exec file { getattr open read execute map }
allow bareboot_gpu_renderer bareboot_gpu_exec file { entrypoint getattr open read execute map }
allow bareboot_daemon bareboot_gpu_guest dir { getattr open read search }
allow bareboot_daemon bareboot_gpu_guest file getattr
allow bareboot_daemon bareboot_gpu_socket dir { getattr search setattr mounton rmdir relabelto remove_name write }
allow bareboot_daemon bareboot_gpu_socket sock_file { getattr unlink }
allow bareboot_daemon socket_device dir { relabelfrom write remove_name }
type_transition bareboot_gpu_renderer bareboot_gpu_socket sock_file bareboot_gpu_socket
allow bareboot_gpu_renderer bareboot_gpu_socket dir { getattr search write add_name remove_name }
allow bareboot_gpu_renderer bareboot_gpu_socket sock_file { create getattr unlink }
allow bareboot_guest bareboot_gpu_socket dir { getattr search }
allow bareboot_guest bareboot_gpu_socket sock_file { getattr write }
allow bareboot_guest bareboot_gpu_renderer unix_stream_socket connectto
allow bareboot_guest bareboot_gpu_renderer fd use
allow bareboot_gpu_renderer bareboot_guest fd use
allow bareboot_guest bareboot_gpu_guest dir { getattr open read search }
allow bareboot_guest bareboot_gpu_guest file { getattr open read execute execute_no_trans map }

allow bareboot_gpu_renderer bareboot_gpu_renderer process { fork getsched setsched }
allow bareboot_gpu_renderer bareboot_gpu_renderer fd use
